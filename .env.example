# Twilio Programmable Voice & Media Streams
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Gnani Speech-to-Text & Text-to-Speech
GNANI_API_KEY=your_gnani_api_key
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=indic-auto
GNANI_TTS_VOICE=Nalini
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_LANGUAGE=en-IN

# LLM Configuration
LLM_PROVIDER=azure_openai
OPEN_AI_DEPLOYMENT_NAME=gpt-4o-mini
OPEN_AI_ENDPOINT=https://your-resource.openai.azure.com/
OPEN_AI_KEY=your_azure_openai_key
OPEN_AI_API_VERSION=2024-02-15-preview

# Database Configuration
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGO_DB_NAME=sales_ai_agent

# Voice Pipeline Parameters
SILENCE_THRESHOLD_MS=2000
MIN_UTTERANCE_MS=300
VAD_ENERGY_THRESHOLD=500

# Server & Public Webhook Host
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
PUBLIC_BASE_URL=

